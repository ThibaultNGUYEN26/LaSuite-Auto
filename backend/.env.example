# Copy this file to backend/.env and keep the real key out of Git.
AUTO_PROVIDER=albert
ALBERT_API_KEY=

# Optional canonical id from Albert's GET /v1/models response.
# Leave empty to select the first available text-generation model dynamically.
ALBERT_MODEL=

ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
DRIVE_BASE_URL=http://localhost:8071
