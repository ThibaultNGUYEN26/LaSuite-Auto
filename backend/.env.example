# Full URL (protocol + host + port) the backend binds to. Must match the
# BACKEND_URL the frontend (app/.env) is configured with, since that's how it
# finds this server — change the host here if the backend runs on a different
# machine than the Electron app.
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated list of origins allowed to call the backend (CORS).
# AUTO_CORS_ORIGINS=*
