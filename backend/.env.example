# Copy this file to backend/.env and keep the real key out of Git.
AUTO_PROVIDER=albert
# Comma-separated permissions granted to discovered capability blocks.
# `*` enables every block. Production should enumerate accepted permissions.
AUTO_ALLOWED_BLOCK_PERMISSIONS=*
ALBERT_API_KEY=

# Optional canonical id from Albert's GET /v1/models response.
# Leave empty to select the first available text-generation model dynamically.
ALBERT_MODEL=
# Optional canonical image-text-to-text model id. Leave empty to resolve one
# dynamically from Albert's live model catalogue.
ALBERT_VISION_MODEL=

ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
DRIVE_BASE_URL=http://10.19.22.91:8071
# Development authentication for user-specific Drive endpoints. Copy the value
# of the `drive_sessionid` cookie from your local Drive login. Never commit it.
DRIVE_SESSION_ID=
# Required by authenticated Drive write operations. Copy the `csrftoken` cookie
# from the same logged-in browser session as DRIVE_SESSION_ID.
DRIVE_CSRF_TOKEN=
# Optional override. Leave empty to use AWS_S3_UPLOAD_ACL from Drive's config.
DRIVE_UPLOAD_ACL=
DRIVE_MAX_CREATE_BYTES=1048576
DRIVE_MAX_BATCH_FILES=50
DRIVE_MAX_UPLOAD_BYTES=52428800
# Safety limits for PDFs downloaded from Drive and returned to the model context.
DRIVE_MAX_DOWNLOAD_BYTES=20971520
PDF_MAX_TEXT_CHARACTERS=80000

# Grist CSV import. Create the API key from Grist account settings > Developer.
GRIST_BASE_URL=http://10.19.22.91:8484
GRIST_API_KEY=
# For http://host/o/docs/, the organization identifier is `docs`.
GRIST_ORG_ID=docs
# Optional default. Leave empty and use grist_list_workspaces to discover an ID.
GRIST_WORKSPACE_ID=
GRIST_MAX_IMPORT_BYTES=10485760

# Local workspace available to specialist agents. It defaults to the current
# user's home folder. Forward slashes work in PowerShell and Git Bash on Windows.
LOCAL_FILES_ROOT=C:/Users/your-name
LOCAL_FILES_MAX_READ_BYTES=20971520
LOCAL_FILES_MAX_CREATE_BYTES=1048576
IMAGE_MAX_READ_BYTES=10485760
# Full URL (protocol + host + port) the backend binds to. Must match the
# BACKEND_URL the frontend (app/.env) is configured with, since that's how it
# finds this server — change the host here if the backend runs on a different
# machine than the Electron app.
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated list of origins allowed to call the backend (CORS).
# AUTO_CORS_ORIGINS=*
